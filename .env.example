# Copy to .env for local tools (not committed).
ANTHROPIC_API_KEY=

# Optional: full path to soffice.exe if LibreOffice is not on PATH
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Print-accurate .docx → PDF on Linux/Vercel (no local LibreOffice): Gotenberg base URL
# Deploy e.g. https://github.com/gotenberg/gotenberg on Fly.io, Railway, or ECS; then:
# GOTENBERG_URL=https://your-gotenberg.example.com
# GOTENBERG_TIMEOUT_SEC=120
# Optional auth in front of Gotenberg:
# GOTENBERG_BASIC_AUTH=user:secret
# GOTENBERG_BEARER_TOKEN=

# Optional tuning (defaults are fine)
# LAYOUT_PDF_MAX_BYTES=2000000
# LAYOUT_PNG_MAX_BYTES=1500000
# LAYOUT_PNG_MAX_EDGE=1400
# SOFFICE_TIMEOUT_SEC=120
