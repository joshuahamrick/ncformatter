{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/process-doc.py": { "maxDuration": 300 },
    "api/process-pdf.py": { "maxDuration": 60 },
    "api/generate-template.py": { "maxDuration": 300 },
    "api/patch-template.py": { "maxDuration": 300 },
    "api/analyze-update.py": { "maxDuration": 300 },
    "api/apply-update.py": { "maxDuration": 300 },
    "api/assistant.py": { "maxDuration": 120 },
    "api/*.py": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/script-new.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/strip-docx-fonts.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
